# Quizint — production environment (copy to deploy/.env)
DOMAIN=quiz.example.fr
# Must be the exact origin browsers use (scheme + host + port): the API refuses unsafe REST requests
# and socket.io handshakes whose Origin differs.
PUBLIC_URL=https://quiz.example.fr
JWT_SECRET=change-me-at-least-32-bytes-long-secret
SEED_ADMIN_EMAIL=admin@example.fr
# 12 to 256 characters. The placeholder is refused in production, and a failing seed stops the API
# container.
SEED_ADMIN_PASSWORD=change-me-12-chars-min
LOG_LEVEL=info
