{
  "name": "@quiz/api",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/reset-test-db.mjs",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "prisma:generate": "prisma generate",
    "check:scores": "tsx scripts/check-scores.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.4",
    "@prisma/client": "^6.5.0",
    "@quiz/shared": "workspace:*",
    "argon2": "^0.41.1",
    "async-mutex": "^0.5.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "file-type": "^22.1.1",
    "music-metadata": "^11.0.0",
    "pino": "^9.6.0",
    "prisma": "^6.5.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.1"
  }
}
