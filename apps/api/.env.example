# Dev environment for apps/api (copy to apps/api/.env)
# The public dev JWT secret below (or no JWT_SECRET at all) is accepted only when NODE_ENV is
# development or test; an unset NODE_ENV counts as production. `pnpm dev` and `db:seed` default it to
# development (scripts/dev-env.mjs). It is deliberately not set here: a copy of this file that ends up
# on a server must not switch the dev relaxations back on.
DATABASE_URL=file:../data/quiz.db?connection_limit=1
# Anywhere reachable by others, replace it with a random secret (at least 32 bytes, 8 distinct
# characters, no repeated pattern):
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=dev-only-insecure-secret-change-me-32b!
# Origin the browser shows in its address bar: unsafe REST requests and socket.io handshakes from any
# other Origin are refused (localhost / 127.0.0.1 / [::1] are interchangeable here, outside production).
# Testing from a phone on the LAN: set it to http://<lan-ip>:5173.
PUBLIC_URL=http://localhost:5173
UPLOADS_DIR=./uploads
LOG_LEVEL=info
SEED_ADMIN_EMAIL=admin@example.fr
SEED_ADMIN_PASSWORD=admin-password-12
